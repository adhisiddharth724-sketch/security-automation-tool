firewall_attack_monitor() {
    echo "=========================================="
    echo "       FIREWALL ATTACK MONITOR"
    echo "=========================================="

    if [ "$EUID" -ne 0 ]; then
        echo "[!] Please run with sudo."
        return 1
    fi

    if ! command -v ufw >/dev/null 2>&1; then
        echo "[!] UFW is not installed."
        return 1
    fi

    echo "[+] Firewall status:"
    ufw status

    echo
    echo "[+] Monitoring blocked connections..."
    echo "[+] Press CTRL+C to stop: "

    LOG="/var/log/ufw.log"

    if [ ! -f "$LOG" ]; then
        echo "[!] UFW log not found."
        echo "    Run: sudo ufw logging on"
        return 1
    fi

    tail -F "$LOG" | while read -r line
    do
        if echo "$line" | grep -q "UFW BLOCK"; then

            SRC=$(echo "$line" | grep -oE 'SRC=[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | cut -d= -f2)
            DST=$(echo "$line" | grep -oE 'DST=[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | cut -d= -f2)
            DPT=$(echo "$line" | grep -oE 'DPT=[0-9]+' | cut -d= -f2)

            echo
            echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            echo "[!] SUSPICIOUS CONNECTION BLOCKED"
            echo "    Source IP : $SRC"
            echo "    Target IP : $DST"
            echo "    Port      : $DPT"
            echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        fi
    done
}

