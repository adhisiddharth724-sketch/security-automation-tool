security_dashboard() {

    clear

    echo "=========================================="
    echo "        SHANKS SECURITY DASHBOARD"
    echo "=========================================="

    # System
    HOSTNAME=$(hostname)

    # Network
    IP=$(hostname -I | awk '{print $1}')

    # Internet
    if ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1
    then
        INTERNET="CONNECTED"
    else
        INTERNET="NOT CONNECTED"
    fi

    # Firewall
    if command -v ufw >/dev/null 2>&1
    then
        if ufw status | grep -q "Status: active"
        then
            FIREWALL="ACTIVE"
        else
            FIREWALL="INACTIVE"
        fi
    else
        FIREWALL="NOT INSTALLED"
    fi

    # Open ports
    OPEN_PORTS=$(ss -tuln | tail -n +2 | wc -l)

    # Active connections
    CONNECTIONS=$(ss -tun | tail -n +2 | wc -l)

    # Failed login attempts
    if [ -f /var/log/auth.log ]
    then
        FAILED_LOGINS=$(grep -i "failed password" /var/log/auth.log 2>/dev/null | wc -l)
    else
        FAILED_LOGINS="N/A"
    fi

    # Security score
    SCORE=100

    if [ "$FIREWALL" != "ACTIVE" ]
    then
        SCORE=$((SCORE - 25))
    fi

    if [ "$INTERNET" != "CONNECTED" ]
    then
        SCORE=$((SCORE - 10))
    fi

    if [ "$OPEN_PORTS" -gt 10 ]
    then
        SCORE=$((SCORE - 15))
    elif [ "$OPEN_PORTS" -gt 5 ]
    then
        SCORE=$((SCORE - 5))
    fi

    if [ "$FAILED_LOGINS" != "N/A" ] && [ "$FAILED_LOGINS" -gt 20 ]
    then
        SCORE=$((SCORE - 15))
    fi

    echo
    echo "System Information"
    echo "------------------------------------------"
    echo "Hostname          : $HOSTNAME"
    echo "IP Address        : $IP"

    echo
    echo "Security Status"
    echo "------------------------------------------"
    echo "Internet          : $INTERNET"
    echo "Firewall          : $FIREWALL"
    echo "Open Ports        : $OPEN_PORTS"
    echo "Active Connections: $CONNECTIONS"
    echo "Failed Logins     : $FAILED_LOGINS"

    echo
    echo "Security Score"
    echo "------------------------------------------"
    echo "Score             : $SCORE / 100"

    if [ "$SCORE" -ge 80 ]
    then
        echo "Status            : GOOD"
    elif [ "$SCORE" -ge 60 ]
    then
        echo "Status            : MODERATE"
    else
        echo "Status            : NEEDS ATTENTION"
    fi

    echo
    echo "=========================================="
}
software_package_audit() {

    clear

    echo "======================================================"
    echo "          SHANKS SOFTWARE / PACKAGE AUDIT"
    echo "======================================================"

    echo
    echo "[+] System      : $(hostname)"
    echo "[+] Date        : $(date)"
    echo "[+] Package Mgr : APT / DPKG"

    # --------------------------------------------------
    # 1. Installed Package Count
    # --------------------------------------------------

    echo
    echo "------------------------------------------------------"
    echo "[1] INSTALLED PACKAGES"
    echo "------------------------------------------------------"

    if command -v dpkg >/dev/null 2>&1
    then
        INSTALLED=$(dpkg-query -W -f='${binary:Package}\n' 2>/dev/null | wc -l)

        echo "Installed Packages : $INSTALLED"
    else
        echo "[!] DPKG not available."
        return 1
    fi


    # --------------------------------------------------
    # 2. Update Repository
    # --------------------------------------------------

    echo
    echo "------------------------------------------------------"
    echo "[2] PACKAGE REPOSITORY STATUS"
    echo "------------------------------------------------------"

    echo "[+] Updating package information..."

    if apt-get update >/dev/null 2>&1
    then
        echo "[✓] Repository information updated."
    else
        echo "[!] Failed to update repository information."
    fi


    # --------------------------------------------------
    # 3. Available Updates
    # --------------------------------------------------

    echo
    echo "------------------------------------------------------"
    echo "[3] AVAILABLE UPDATES"
    echo "------------------------------------------------------"

    UPDATES=$(apt list --upgradable 2>/dev/null | tail -n +2)

    if [ -z "$UPDATES" ]
    then
        UPDATE_COUNT=0

        echo "[✓] No package updates available."

    else
        UPDATE_COUNT=$(echo "$UPDATES" | wc -l)

        echo "[!] Updates Available : $UPDATE_COUNT"
        echo

        echo "$UPDATES" | head -20

        if [ "$UPDATE_COUNT" -gt 20 ]
        then
            echo
            echo "... and more."
        fi
    fi


    # --------------------------------------------------
    # 4. Held Packages
    # --------------------------------------------------

    echo
    echo "------------------------------------------------------"
    echo "[4] HELD PACKAGES"
    echo "------------------------------------------------------"

    HELD=$(apt-mark showhold 2>/dev/null)

    if [ -z "$HELD" ]
    then
        HELD_COUNT=0
        echo "[✓] No packages are being held."
    else
        HELD_COUNT=$(echo "$HELD" | wc -l)

        echo "[!] Held Packages : $HELD_COUNT"
        echo
        echo "$HELD"
    fi


    # --------------------------------------------------
    # 5. Recently Installed Packages
    # --------------------------------------------------

    echo
    echo "------------------------------------------------------"
    echo "[5] RECENTLY INSTALLED PACKAGES"
    echo "------------------------------------------------------"

    if [ -f /var/log/dpkg.log ]
    then
        grep " install " /var/log/dpkg.log 2>/dev/null | tail -10
    else
        echo "[!] dpkg.log not found."
    fi


    # --------------------------------------------------
    # 6. Package Manager Health
    # --------------------------------------------------

    echo
    echo "------------------------------------------------------"
    echo "[6] PACKAGE MANAGER HEALTH"
    echo "------------------------------------------------------"

    if dpkg --audit 2>/dev/null | grep -q .
    then
        echo "[!] Package manager reports problems:"
        dpkg --audit
        PACKAGE_STATUS="ATTENTION REQUIRED"
    else
        echo "[✓] No broken package configuration detected."
        PACKAGE_STATUS="HEALTHY"
    fi


    # --------------------------------------------------
    # 7. Security Summary
    # --------------------------------------------------

    echo
    echo "======================================================"
    echo "                 AUDIT SUMMARY"
    echo "======================================================"

    echo "Installed Packages : $INSTALLED"
    echo "Available Updates  : $UPDATE_COUNT"
    echo "Held Packages      : $HELD_COUNT"
    echo "Package Manager    : $PACKAGE_STATUS"

    echo
    echo "Security Assessment:"
    echo "------------------------------------------------------"

    if [ "$PACKAGE_STATUS" != "HEALTHY" ]
    then
        echo "[HIGH] Package manager requires attention."

    elif [ "$UPDATE_COUNT" -gt 20 ]
    then
        echo "[MEDIUM] Large number of package updates available."

    elif [ "$UPDATE_COUNT" -gt 0 ]
    then
        echo "[LOW] Package updates are available."

    else
        echo "[GOOD] System packages appear up to date."
    fi

    echo
    echo "======================================================"
    echo "          SOFTWARE AUDIT COMPLETED"
    echo "======================================================"
}
file_permission_audit() {

    clear

    echo "======================================================"
    echo "          SHANKS FILE PERMISSION AUDIT"
    echo "======================================================"
    echo "Started : $(date)"
    echo

    # --------------------------------------------------
    # Counters
    # --------------------------------------------------

    WORLD_WRITABLE_FILES=0
    WORLD_WRITABLE_DIRS=0
    SUID_COUNT=0
    SGID_COUNT=0
    SENSITIVE_ISSUES=0

    HIGH=0
    MEDIUM=0
    INFO=0

    # --------------------------------------------------
    # 1. World-Writable Files
    # --------------------------------------------------

    echo "------------------------------------------------------"
    echo "[1] WORLD-WRITABLE FILES"
    echo "------------------------------------------------------"

    WW_FILES=$(find / \
        -xdev \
        -type f \
        -perm -0002 \
        -not -path "/proc/*" \
        -not -path "/sys/*" \
        -not -path "/run/*" \
        2>/dev/null)

    if [ -z "$WW_FILES" ]
    then
        echo "[✓] No world-writable files found."
    else
        echo "$WW_FILES" | head -30

        WORLD_WRITABLE_FILES=$(echo "$WW_FILES" | wc -l)

        echo
        echo "[!] Found: $WORLD_WRITABLE_FILES world-writable file(s)"

        HIGH=$((HIGH + 1))
    fi


    # --------------------------------------------------
    # 2. World-Writable Directories
    # --------------------------------------------------

    echo
    echo "------------------------------------------------------"
    echo "[2] WORLD-WRITABLE DIRECTORIES"
    echo "------------------------------------------------------"

    WW_DIRS=$(find / \
        -xdev \
        -type d \
        -perm -0002 \
        -not -path "/proc/*" \
        -not -path "/sys/*" \
        -not -path "/run/*" \
        2>/dev/null)

    if [ -z "$WW_DIRS" ]
    then
        echo "[✓] No world-writable directories found."
    else

        echo "$WW_DIRS" | while read -r DIR
        do
            PERM=$(stat -c "%A" "$DIR" 2>/dev/null)

            # Sticky bit = safer shared directory
            if [[ "$PERM" == *t ]]
            then
                echo "[INFO] $DIR  $PERM  (sticky bit)"
            else
                echo "[WARN] $DIR  $PERM"
            fi
        done

        WORLD_WRITABLE_DIRS=$(echo "$WW_DIRS" | wc -l)

        echo
        echo "[!] Found: $WORLD_WRITABLE_DIRS world-writable directorie(s)"

        MEDIUM=$((MEDIUM + 1))
    fi


    # --------------------------------------------------
    # 3. SUID Files
    # --------------------------------------------------

    echo
    echo "------------------------------------------------------"
    echo "[3] SUID FILES"
    echo "------------------------------------------------------"

    SUID_FILES=$(find / \
        -xdev \
        -type f \
        -perm -4000 \
        -not -path "/proc/*" \
        -not -path "/sys/*" \
        2>/dev/null)

    if [ -z "$SUID_FILES" ]
    then
        echo "[✓] No SUID files found."
    else

        echo "$SUID_FILES" | head -30

        SUID_COUNT=$(echo "$SUID_FILES" | wc -l)

        echo
        echo "[INFO] SUID files found: $SUID_COUNT"
        echo "[INFO] Review unexpected SUID binaries."

        INFO=$((INFO + 1))
    fi


    # --------------------------------------------------
    # 4. SGID Files
    # --------------------------------------------------

    echo
    echo "------------------------------------------------------"
    echo "[4] SGID FILES"
    echo "------------------------------------------------------"

    SGID_FILES=$(find / \
        -xdev \
        -type f \
        -perm -2000 \
        -not -path "/proc/*" \
        -not -path "/sys/*" \
        2>/dev/null)

    if [ -z "$SGID_FILES" ]
    then
        echo "[✓] No SGID files found."
    else

        echo "$SGID_FILES" | head -30

        SGID_COUNT=$(echo "$SGID_FILES" | wc -l)

        echo
        echo "[INFO] SGID files found: $SGID_COUNT"
        echo "[INFO] Review unexpected SGID binaries."

        INFO=$((INFO + 1))
    fi


    # --------------------------------------------------
    # 5. Sensitive File Permissions
    # --------------------------------------------------

    echo
    echo "------------------------------------------------------"
    echo "[5] SENSITIVE FILE PERMISSIONS"
    echo "------------------------------------------------------"

    SENSITIVE_FILES=(
        "/etc/passwd"
        "/etc/shadow"
        "/etc/group"
        "/etc/sudoers"
    )

    for FILE in "${SENSITIVE_FILES[@]}"
    do

        if [ -e "$FILE" ]
        then

            PERM=$(stat -c "%a" "$FILE" 2>/dev/null)
            OWNER=$(stat -c "%U:%G" "$FILE" 2>/dev/null)

            echo
            echo "File   : $FILE"
            echo "Owner  : $OWNER"
            echo "Mode   : $PERM"

            # Check whether others have write permission
            if [ $((PERM % 10)) -ge 2 ]
            then
                echo "[HIGH] Others have write permission!"
                SENSITIVE_ISSUES=$((SENSITIVE_ISSUES + 1))
                HIGH=$((HIGH + 1))
            else
                echo "[✓] Others cannot write."
            fi

        fi

    done


    # --------------------------------------------------
    # 6. Home Directory Permissions
    # --------------------------------------------------

    echo
    echo "------------------------------------------------------"
    echo "[6] HOME DIRECTORY PERMISSIONS"
    echo "------------------------------------------------------"

    for HOME_DIR in /home/*
    do

        if [ -d "$HOME_DIR" ]
        then

            PERM=$(stat -c "%A" "$HOME_DIR" 2>/dev/null)
            OWNER=$(stat -c "%U" "$HOME_DIR" 2>/dev/null)

            echo
            echo "Directory : $HOME_DIR"
            echo "Owner     : $OWNER"
            echo "Permission: $PERM"

            if [ -w "$HOME_DIR" ] && [ ! -O "$HOME_DIR" ]
            then
                echo "[WARN] Directory may be writable by another user."
                MEDIUM=$((MEDIUM + 1))
            else
                echo "[✓] No obvious ownership/write issue."
            fi

        fi

    done


    # --------------------------------------------------
    # 7. Final Summary
    # --------------------------------------------------

    echo
    echo "======================================================"
    echo "                 AUDIT SUMMARY"
    echo "======================================================"

    echo
    echo "World-Writable Files : $WORLD_WRITABLE_FILES"
    echo "World-Writable Dirs  : $WORLD_WRITABLE_DIRS"
    echo "SUID Files           : $SUID_COUNT"
    echo "SGID Files           : $SGID_COUNT"
    echo "Sensitive Issues     : $SENSITIVE_ISSUES"

    echo
    echo "Severity Summary"
    echo "------------------------------------------------------"

    echo "HIGH                 : $HIGH"
    echo "MEDIUM               : $MEDIUM"
    echo "INFO                 : $INFO"

    echo

    if [ "$HIGH" -gt 0 ]
    then
        echo "[HIGH RISK] Permission issues require investigation."

    elif [ "$MEDIUM" -gt 0 ]
    then
        echo "[MEDIUM] Permission findings require review."

    else
        echo "[GOOD] No major permission issues detected."
    fi

    echo
    echo "======================================================"
    echo "          FILE PERMISSION AUDIT COMPLETED"
    echo "======================================================"
}

